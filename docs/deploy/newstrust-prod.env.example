# Copie para o servidor: /etc/newstrust/newstrust-prod.env
# chmod 600, dono jgrando. NUNCA commite o ficheiro real com segredos.
#
# So o que e realmente secreto vem daqui - porta, modelo do Gemini, URL do
# ScamAdviser e perfil de pesos ja sao valores literais em
# application-prod.properties (nao mudam por instancia, entao nao sao segredo).

DB_URL=jdbc:postgresql://localhost:5432/newstrust_prod
DB_USERNAME=newstrust_user
DB_PASSWORD=ALTERE_A_SENHA_DO_POSTGRES

# Gemini - chave de PRODUCAO (nunca a mesma do dev, para nao misturar
# quota/billing/logs dos dois ambientes)
GEMINI_API_KEY_PROD=SUA_CHAVE_DE_PRODUCAO_DO_GEMINI

# ScamAdviser
SCAMADVISER_API_KEY=SUA_CHAVE_DO_SCAMADVISER
