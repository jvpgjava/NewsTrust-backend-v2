# Copie para o servidor: /etc/newstrust/newstrust-dev.env
# chmod 600, dono jgrando. NUNCA commite o ficheiro real com segredos.
#
# Modelo do Gemini, URL do ScamAdviser e perfil de pesos ja sao valores
# literais em application-dev.properties. SERVER_PORT continua aqui (diferente
# de prod) porque este mesmo profile tambem roda na maquina local de qualquer
# desenvolvedor, onde a porta padrao 8080 faz sentido - so a instancia da VPS
# precisa da 8181, para nao colidir com a de producao na mesma maquina.

SERVER_PORT=8181

DB_URL=jdbc:postgresql://localhost:5432/newstrust_dev
DB_USERNAME=newstrust_user
DB_PASSWORD=ALTERE_A_SENHA_DO_POSTGRES

# Gemini - chave de DEV/HOMOLOG (diferente da de producao)
GEMINI_API_KEY_DEV=SUA_CHAVE_DE_DEV_DO_GEMINI

# ScamAdviser (pode reusar a mesma chave do prod se o plano permitir)
SCAMADVISER_API_KEY=SUA_CHAVE_DO_SCAMADVISER
